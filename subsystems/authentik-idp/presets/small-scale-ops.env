# ============================================
# authentik-idp: Small-Scale Ops Preset
# ============================================
# Purpose: Single-node "small ops" deployment
# Security: REVIEW REQUIRED - do not use defaults
# ============================================

# Populate real secrets and review Authentik hardening guidance.

PG_PASS=
AUTHENTIK_SECRET_KEY=

# Optional bootstrap (recommend disabling after initial provisioning)
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_EMAIL=

AUTHENTIK_VERSION=2024.12
VALKEY_VERSION=v0.3.0

AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443

# OIDC defaults (override as needed)
OIDC_PROVIDER_NAME=Fulmen Provider
OIDC_APP_NAME=Fulmen Application
OIDC_APP_SLUG=test-app
OIDC_CLIENT_ID=test-client
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URIS=http://localhost:8080/callback

FIXTURE_USER_PASSWORD=
