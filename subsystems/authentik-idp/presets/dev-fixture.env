# ============================================
# authentik-idp: Dev Fixture Preset
# ============================================
# Purpose: Local development and integration testing
# Security: NOT FOR PRODUCTION - uses known credentials
# ============================================

# --- Core Secrets ---
PG_PASS=dev-postgres-password
# Authentik requires a long secret key
AUTHENTIK_SECRET_KEY=dev-secret-key-minimum-fifty-characters-for-authentik

# --- Bootstrap ---
AUTHENTIK_BOOTSTRAP_PASSWORD=admin-dev-password
AUTHENTIK_BOOTSTRAP_TOKEN=devbootstrap0123456789abcdef0123456789abcdef0123456789abcdef01234567
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost

# --- Versions ---
AUTHENTIK_VERSION=2024.12
VALKEY_VERSION=v0.3.0

# --- Ports ---
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443

# --- OIDC Provider ---
OIDC_PROVIDER_NAME=Dev Test Provider
OIDC_APP_NAME=Dev Test Application
OIDC_APP_SLUG=test-app
OIDC_CLIENT_ID=test-client
OIDC_CLIENT_SECRET=test-secret
OIDC_REDIRECT_URIS=http://localhost:8080/callback

# --- Fixture Users ---
FIXTURE_USER_PASSWORD=fixture-password-not-for-prod
