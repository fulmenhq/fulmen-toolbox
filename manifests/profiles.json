{
  "$schema": "https://schema.fulmenhq.dev/fulmen-toolbox/profile-manifest.schema.json",
  "profiles": {
    "runner_baseline": {
      "description": "CI runner baseline userland (apk packages)",
      "package_manager": "apk",
      "packages": [
        "bash",
        "build-base",
        "ca-certificates",
        "coreutils",
        "curl",
        "diffutils",
        "findutils",
        "git",
        "gzip",
        "make",
        "openssh-client",
        "pkgconf",
        "python3",
        "tar",
        "unzip",
        "yamllint",
        "xz"
      ]
    },
    "runner_baseline_apt": {
      "description": "CI runner baseline userland + build tools (apt packages)",
      "package_manager": "apt",
      "packages": [
        "bash",
        "build-essential",
        "ca-certificates",
        "coreutils",
        "curl",
        "diffutils",
        "findutils",
        "g++",
        "gcc",
        "git",
        "gzip",
        "libc6-dev",
        "make",
        "openssh-client",
        "pkg-config",
        "python3",
        "tar",
        "unzip",
        "yamllint",
        "xz-utils"
      ]
    }
  }
}
